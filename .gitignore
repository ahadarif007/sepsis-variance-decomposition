# ----------------------------
# Repository-level .gitignore
# ----------------------------

# ---- Claude / AI assistant ----
.claude/
CLAUDE.md

# ---- Large project data ----
data/
processed_data/

# Project-specific outputs
sepsis/project/output/

# ---- R ----
.Rhistory
.RData
.Rproj.user/
*.Rproj

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
pip-wheel-metadata/

# ---- Virtualenvs / environment files ----
.env
.envrc
.venv/
venv/
env/
ENV/
Pipfile.lock

# ---- IDE / editor configs ----
.idea/
.vscode/

# ---- LaTeX build artifacts ----
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.lof
*.lot
*.toc
*.nav
*.snm
*.vrb
*.run.xml
*.synctex.gz
*.knit.md

# ---- Jupyter ----
.ipynb_checkpoints/

# ---- Testing / coverage ----
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# ---- Logs and runtime files ----
*.log
logs/
*.out

# ---- OS-specific files ----
.DS_Store
Thumbs.db

# ---- Database / local storage ----
*.sqlite3
*.db
*.db-journal

# ---- Sensitive / secret files ----
*.key
*.pem
*.secret
secrets.json

# ---- Large binary data ----
*.parquet
*.feather
*.h5
*.hdf5
*.nc
*.sav

# ---- Misc ----
*.swp
*.swo
*~

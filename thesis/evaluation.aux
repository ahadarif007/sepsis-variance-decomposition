\@writefile{lot}{\contentsline {table}{\numberline {5.3}{\ignorespaces Ten largest coefficients (original scale) in the Analysis-1 elastic-net model. Features ending in \_msg are binary ``was measured'' indicators. The act of ordering a P/F ratio is the single strongest predictor (OR 5.46), confirming an informative-missingness signal.}}{29}{table.5.3}\protected@file@percent }
\newlabel{table:coefs}{{5.3}{29}{Ten largest coefficients (original scale) in the Analysis-1 elastic-net model. Features ending in \_msg are binary ``was measured'' indicators. The act of ordering a P/F ratio is the single strongest predictor (OR 5.46), confirming an informative-missingness signal}{table.5.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5.4}{\ignorespaces Calibration curve (out-of-sample) for the Analysis-1 elastic-net nomogram at the hour-six landmark. Points near the diagonal indicate that predicted risks are usable as probabilities, not merely as a ranking.}}{30}{figure.5.4}\protected@file@percent }
\newlabel{fig:calibration_h6}{{5.4}{30}{Calibration curve (out-of-sample) for the Analysis-1 elastic-net nomogram at the hour-six landmark. Points near the diagonal indicate that predicted risks are usable as probabilities, not merely as a ranking}{figure.5.4}{}}
\@writefile{toc}{\contentsline {section}{\numberline {5.6}Analysis 2: Dynamic Landmark Supermodel (C1)}{30}{section.5.6}\protected@file@percent }
\newlabel{sec:supermodel_results}{{5.6}{30}{Analysis 2: Dynamic Landmark Supermodel (C1)}{section.5.6}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.6.1}Overall Discrimination}{30}{subsection.5.6.1}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {5.4}{\ignorespaces Dynamic discrimination AUC($s$): one supermodel evaluated at each prediction hour, versus a separate model per landmark. The single supermodel matches the accuracy of bespoke per-landmark models while remaining one parsimonious, deployable object.}}{31}{table.5.4}\protected@file@percent }
\newlabel{table:auc_by_landmark}{{5.4}{31}{Dynamic discrimination AUC($s$): one supermodel evaluated at each prediction hour, versus a separate model per landmark. The single supermodel matches the accuracy of bespoke per-landmark models while remaining one parsimonious, deployable object}{table.5.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5.5}{\ignorespaces Dynamic AUC($s$): the supermodel's out-of-sample discrimination as a function of the hour at which the prediction is made, versus separate per-landmark models. The supermodel matches or exceeds the bespoke models at most landmarks while requiring only one set of coefficients.}}{31}{figure.5.5}\protected@file@percent }
\newlabel{fig:auc_by_landmark}{{5.5}{31}{Dynamic AUC($s$): the supermodel's out-of-sample discrimination as a function of the hour at which the prediction is made, versus separate per-landmark models. The supermodel matches or exceeds the bespoke models at most landmarks while requiring only one set of coefficients}{figure.5.5}{}}

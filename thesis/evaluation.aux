\@writefile{lof}{\contentsline {figure}{\numberline {5.3}{\ignorespaces Left: mean hourly heart rate by sepsis status; septic patients run higher and diverge over time. Right: distribution of within-patient lag-1 autocorrelation of heart rate; the mean of 0.57 confirms strong hour-to-hour dependence that the static analysis discarded.}}{27}{figure.5.3}\protected@file@percent }
\newlabel{fig:trajectories_acf}{{5.3}{27}{Left: mean hourly heart rate by sepsis status; septic patients run higher and diverge over time. Right: distribution of within-patient lag-1 autocorrelation of heart rate; the mean of 0.57 confirms strong hour-to-hour dependence that the static analysis discarded}{figure.5.3}{}}

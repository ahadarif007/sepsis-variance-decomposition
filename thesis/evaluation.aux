\@writefile{lot}{\contentsline {table}{\numberline {5.2}{\ignorespaces Discrimination at the hour-six landmark (incident onset within 12\,h) on MIMIC-IV. The full-feature elastic-net nomogram is the statistical ceiling at a single landmark.}}{28}{table.5.2}\protected@file@percent }

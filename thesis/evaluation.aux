\@writefile{lof}{\contentsline {figure}{\numberline {5.1}{\ignorespaces Cumulative incidence of sepsis onset from the hour-six landmark, stratified by SIRS status. Patients with $\ge 2$ SIRS criteria develop sepsis faster, confirming that inflammatory markers carry predictive signal for the incident-onset task.}}{25}{figure.5.1}\protected@file@percent }
\newlabel{fig:km_cumulative}{{5.1}{25}{Cumulative incidence of sepsis onset from the hour-six landmark, stratified by SIRS status. Patients with $\ge 2$ SIRS criteria develop sepsis faster, confirming that inflammatory markers carry predictive signal for the incident-onset task}{figure.5.1}{}}
\@writefile{toc}{\contentsline {paragraph}{Competing risks.}{25}{section*.31}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5.2}{\ignorespaces Cumulative incidence functions from the hour-six landmark accounting for death without sepsis as a competing risk, stratified by SIRS status. The solid lines show onset incidence; the dashed lines show the competing risk of death without sepsis.}}{26}{figure.5.2}\protected@file@percent }
\newlabel{fig:competing_risks}{{5.2}{26}{Cumulative incidence functions from the hour-six landmark accounting for death without sepsis as a competing risk, stratified by SIRS status. The solid lines show onset incidence; the dashed lines show the competing risk of death without sepsis}{figure.5.2}{}}

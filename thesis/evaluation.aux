\@writefile{lof}{\contentsline {figure}{\numberline {5.6}{\ignorespaces Time-dependent AUC for predicting sepsis onset over increasing horizons from the hour-six landmark. Discrimination remains above 0.70 across all tested horizons, demonstrating robust risk stratification over time.}}{33}{figure.5.6}\protected@file@percent }
\newlabel{fig:timedep_auc}{{5.6}{33}{Time-dependent AUC for predicting sepsis onset over increasing horizons from the hour-six landmark. Discrimination remains above 0.70 across all tested horizons, demonstrating robust risk stratification over time}{figure.5.6}{}}
\@writefile{toc}{\contentsline {section}{\numberline {5.7}Analysis 3: Within-Patient Correlation (GEE and Time-Varying Cox)}{33}{section.5.7}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {5.5}{\ignorespaces Pooled logistic model: naive versus cluster-robust standard errors. Ignoring within-patient correlation understates every SE by 2--4.5 times.}}{34}{table.5.5}\protected@file@percent }
\newlabel{table:gee_se}{{5.5}{34}{Pooled logistic model: naive versus cluster-robust standard errors. Ignoring within-patient correlation understates every SE by 2--4.5 times}{table.5.5}{}}
\@writefile{toc}{\contentsline {section}{\numberline {5.8}Analysis 4: Real-Time Evaluation (Utility and Alarm Burden)}{34}{section.5.8}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{PhysioNet utility.}{34}{section*.32}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Alarm burden.}{34}{section*.33}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5.7}{\ignorespaces Alarm-burden trade-off for the real-time supermodel. High sensitivity ($\ge 90\%$) is achievable only at alarm rates (6.5 false alarms per patient-day) that would fatigue bedside staff. A practical operating point (51\% sensitivity, 0.7 false alarms per patient-day) balances detection against alarm fatigue.}}{35}{figure.5.7}\protected@file@percent }
\newlabel{fig:alarm_tradeoff}{{5.7}{35}{Alarm-burden trade-off for the real-time supermodel. High sensitivity ($\ge 90\%$) is achievable only at alarm rates (6.5 false alarms per patient-day) that would fatigue bedside staff. A practical operating point (51\% sensitivity, 0.7 false alarms per patient-day) balances detection against alarm fatigue}{figure.5.7}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5.6}{\ignorespaces Operating points: earlier/more-sensitive detection costs rapidly rising false-alarm burden.}}{35}{table.5.6}\protected@file@percent }
\newlabel{table:alarm_ops}{{5.6}{35}{Operating points: earlier/more-sensitive detection costs rapidly rising false-alarm burden}{table.5.6}{}}
\@writefile{toc}{\contentsline {section}{\numberline {5.9}Analysis 5: Subgroup Fairness}{36}{section.5.9}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {5.7}{\ignorespaces Subgroup discrimination and calibration-in-the-large. The model performs consistently across sex and age, with no evidence of systematic under- or over-prediction in any subgroup.}}{36}{table.5.7}\protected@file@percent }
\newlabel{table:subgroups}{{5.7}{36}{Subgroup discrimination and calibration-in-the-large. The model performs consistently across sex and age, with no evidence of systematic under- or over-prediction in any subgroup}{table.5.7}{}}
\@writefile{toc}{\contentsline {section}{\numberline {5.10}Analysis 6: Group-Based Trajectory Modelling}{36}{section.5.10}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5.8}{\ignorespaces GBTM: three latent SOFA-trajectory classes over the first 24 ICU hours. Class 1 (mildest) is flat near zero; Class 2 (intermediate) rises to SOFA $\sim $3; Class 3 (most severe) rises steeply to SOFA $\sim $7. The trajectory \emph  {shape}, not just its endpoint, carries prognostic and predictive information.}}{37}{figure.5.8}\protected@file@percent }
\newlabel{fig:gbtm}{{5.8}{37}{GBTM: three latent SOFA-trajectory classes over the first 24 ICU hours. Class 1 (mildest) is flat near zero; Class 2 (intermediate) rises to SOFA $\sim $3; Class 3 (most severe) rises steeply to SOFA $\sim $7. The trajectory \emph {shape}, not just its endpoint, carries prognostic and predictive information}{figure.5.8}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5.8}{\ignorespaces Cox model: in-hospital mortality by GBTM trajectory class (reference = mildest class), adjusted for age.}}{37}{table.5.8}\protected@file@percent }
\newlabel{table:gbtm_mortality}{{5.8}{37}{Cox model: in-hospital mortality by GBTM trajectory class (reference = mildest class), adjusted for age}{table.5.8}{}}
\citation{yang2022gbtm}
\@writefile{lot}{\contentsline {table}{\numberline {5.9}{\ignorespaces Logistic model: incident Sepsis-3 by GBTM trajectory class (reference = mildest class). The most-severe trajectory carries an 18-fold odds of subsequent onset.}}{38}{table.5.9}\protected@file@percent }
\newlabel{table:gbtm_onset}{{5.9}{38}{Logistic model: incident Sepsis-3 by GBTM trajectory class (reference = mildest class). The most-severe trajectory carries an 18-fold odds of subsequent onset}{table.5.9}{}}
\@writefile{toc}{\contentsline {section}{\numberline {5.11}Analysis 7: Confounder-Adjusted Causal Analysis}{38}{section.5.11}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5.9}{\ignorespaces Love plot: covariate balance before (red) and after (teal) propensity-score matching. All standardised mean differences fall below 0.1 after matching, confirming adequate balance.}}{39}{figure.5.9}\protected@file@percent }
\newlabel{fig:love_plot}{{5.9}{39}{Love plot: covariate balance before (red) and after (teal) propensity-score matching. All standardised mean differences fall below 0.1 after matching, confirming adequate balance}{figure.5.9}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5.10}{\ignorespaces Effect of early ($\le 3$h) versus delayed antibiotics on in-hospital mortality. All four estimators agree in direction and magnitude: early antibiotics associate with approximately 10\% lower odds of death.}}{39}{table.5.10}\protected@file@percent }
\newlabel{table:causal}{{5.10}{39}{Effect of early ($\le 3$h) versus delayed antibiotics on in-hospital mortality. All four estimators agree in direction and magnitude: early antibiotics associate with approximately 10\% lower odds of death}{table.5.10}{}}

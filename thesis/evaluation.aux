\@writefile{lot}{\contentsline {table}{\numberline {5.11}{\ignorespaces External validation of the frozen Analysis-1 nomogram on eICU-CRD. Discrimination transports with modest degradation; the gap between frozen (0.686) and internal refit (0.711) reflects population heterogeneity, not model failure.}}{40}{table.5.11}\protected@file@percent }
\newlabel{table:external}{{5.11}{40}{External validation of the frozen Analysis-1 nomogram on eICU-CRD. Discrimination transports with modest degradation; the gap between frozen (0.686) and internal refit (0.711) reflects population heterogeneity, not model failure}{table.5.11}{}}

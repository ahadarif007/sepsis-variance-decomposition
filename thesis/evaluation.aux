\@writefile{lot}{\contentsline {table}{\numberline {5.1}{\ignorespaces Cox model for time to incident sepsis (hour-six landmark). SIRS and vital signs carry the hazard, while a single-timepoint SOFA value is \emph  {inversely} associated with incident onset.}}{26}{table.5.1}\protected@file@percent }
\newlabel{table:cox_baseline}{{5.1}{26}{Cox model for time to incident sepsis (hour-six landmark). SIRS and vital signs carry the hazard, while a single-timepoint SOFA value is \emph {inversely} associated with incident onset}{table.5.1}{}}
